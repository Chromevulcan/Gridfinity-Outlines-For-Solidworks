<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line tool: turns outline-app DXF/SVG exports into tray JSON (and a preview) without SolidWorks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>gridfinity-outlines</AssemblyName>
    <RootNamespace>Gridfinity.Cli</RootNamespace>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gridfinity.Core\Gridfinity.Core.csproj" />
    <ProjectReference Include="..\Gridfinity.Trace\Gridfinity.Trace.csproj" />
  </ItemGroup>

  <!-- Native OpenCV for the photo tracer, for Windows and Linux. -->
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.runtime.win.slim" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64.slim" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>
