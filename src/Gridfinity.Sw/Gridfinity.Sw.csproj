<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SolidWorks add-ins are 64-bit .NET Framework assemblies. Override the API folder if yours differs:
      dotnet build -p:SolidWorksApiDir="D:\SOLIDWORKS\api\redist"
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>1.3.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Gridfinity.Sw</RootNamespace>
    <AssemblyName>GridfinityOutlines.Sw</AssemblyName>
    <SolidWorksApiDir Condition="'$(SolidWorksApiDir)' == ''">D:\Dassault Systemes\SOLIDWORKS 3DEXPERIENCE R2026x\SOLIDWORKS\api\redist</SolidWorksApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />

    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>

    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Native OpenCV for the photo tracer; lands in dll\x64\OpenCvSharpExtern.dll next to the add-in. -->
    <PackageReference Include="OpenCvSharp4.runtime.win.slim" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gridfinity.Core\Gridfinity.Core.csproj" />
    <ProjectReference Include="..\Gridfinity.Trace\Gridfinity.Trace.csproj" />
  </ItemGroup>

</Project>
